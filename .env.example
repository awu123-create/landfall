# Local PostgreSQL 16 & Redis 7 (docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_DB=landfall
POSTGRES_USER=landfall
POSTGRES_PASSWORD=landfall123
POSTGRES_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Backend HTTP port (backend/src/main/resources/application.yml)
SERVER_PORT=8080

# Local default super-admin bootstrap (set false in production)
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@landfall.local
BOOTSTRAP_ADMIN_PASSWORD=Admin123456
BOOTSTRAP_ADMIN_NICKNAME=系统管理员
